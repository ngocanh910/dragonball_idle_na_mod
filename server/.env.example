# ============================================================
# Dragon Ball Idle — Emulator Server Environment
# Copy to server/.env and adjust. Node loads .env natively (no dotenv).
# ============================================================

# ── HTTP ────────────────────────────────────────────────────
# PORT=8080
# HOST=0.0.0.0

# Public hostname for client-facing URLs (must be reachable by the
# browser playing the game). Set to your LAN IP for remote devices.
# PUBLIC_HOST=127.0.0.1

# ── Game ────────────────────────────────────────────────────
# SERVER_NAME=Local Emulator
# DEFAULT_SERVER_ID=1

# ── Mod system ──────────────────────────────────────────────
# MODS_ENABLED=true

# ── Media / CDN backfill ────────────────────────────────────
# Lazy-fetch missing art from the live CDN. Set false for pure-offline.
# CDN_BACKFILL=true
# CDN_BASE=https://dragonh5cdn.popoh5.com/bs/resource

# ── Debug ───────────────────────────────────────────────────
# DEBUG=false

# ── Database ────────────────────────────────────────────────
# Used by Prisma (server/prisma/schema.prisma). Path is relative
# to server/prisma/.
# DATABASE_URL="file:./data.db"
